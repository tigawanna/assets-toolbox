{
  "name": "assets-toolbox",
  "private": true,
  "description": "CLI and local-app tools for brand, social-preview, Expo, and store-listing assets.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "vp lint --deny-warnings .",
    "lint:fix": "vp lint --fix .",
    "format": "vp fmt .",
    "format:fix": "vp fmt .",
    "check-types": "turbo run typecheck",
    "check-exports": "turbo run check-exports",
    "quality": "turbo run //#lint //#format check-types test"
  },
  "devDependencies": {
    "@shadcn/lint": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0"
}
