{
  "name": "@tigawanna/appstore-screenshots",
  "version": "0.1.0",
  "description": "Fit raw simulator captures to App Store Connect screenshot sizes, with pure policy checks and a deliver inventory.",
  "keywords": [
    "app-store",
    "app-store-connect",
    "cli",
    "deliver",
    "fastlane",
    "ios",
    "screenshots"
  ],
  "homepage": "https://github.com/tigawanna/assets-toolbox/tree/main/packages/appstore-screenshots#readme",
  "license": "MIT",
  "author": "tigawanna <tigawanna@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigawanna/assets-toolbox.git",
    "directory": "packages/appstore-screenshots"
  },
  "bin": {
    "appstore-screenshots": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./sizes": {
      "types": "./dist/sizes.d.mts",
      "import": "./dist/sizes.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "node dist/cli.mjs",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:fix": "vp fmt --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "prepublishOnly": "pnpm run build && pnpm run check-exports"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "^25.9.9",
    "bumpp": "^12.3.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
