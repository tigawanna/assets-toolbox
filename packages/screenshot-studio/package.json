{
  "name": "@tigawanna/screenshot-studio",
  "version": "0.1.0",
  "description": "Local TanStack Start canvas for placing Play and App Store screenshot frames. Edits are an event log the Node server can read.",
  "keywords": [
    "app-store",
    "canvas",
    "google-play",
    "screenshots",
    "tanstack-start"
  ],
  "homepage": "https://github.com/tigawanna/assets-toolbox/tree/main/packages/screenshot-studio#readme",
  "bugs": {
    "url": "https://github.com/tigawanna/assets-toolbox/issues"
  },
  "license": "MIT",
  "author": "tigawanna <tigawanna@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigawanna/assets-toolbox.git",
    "directory": "packages/screenshot-studio"
  },
  "bin": {
    "screenshot-studio": "./bin/screenshot-studio.mjs"
  },
  "files": [
    "bin",
    ".output",
    "assets",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp dev --port 4320",
    "build": "vp build",
    "preview": "vp preview",
    "start": "node bin/screenshot-studio.mjs --no-open",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:fix": "vp fmt --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepublishOnly": "pnpm run build",
    "check-exports": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "postbuild": "npm run check-exports",
    "release": "changeset publish:screenshot-studio"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/react-db": "1.0.0-rc.1.5",
    "@tanstack/react-hotkeys": "^0.27.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@vitejs/plugin-react": "6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.6",
    "konva": "9.3.22",
    "lucide-react": "^0.554.0",
    "nitro": "3.0.261103-rc",
    "open": "^11.0.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-konva": "19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "1.0.0-rc.6",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
