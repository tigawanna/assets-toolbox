{
  "name": "@tigawanna/svg-compose",
  "version": "0.1.0",
  "description": "Local SVG compositor: import, flatten, edit and export small SVG assets.",
  "license": "MIT",
  "author": "tigawanna <tigawanna@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigawanna/assets-toolbox.git",
    "directory": "packages/svg-compose"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vp dev --port 4330",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "fmt:check": "vp fmt --check",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish:svg-compose"
  },
  "dependencies": {
    "dompurify": "3.5.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
