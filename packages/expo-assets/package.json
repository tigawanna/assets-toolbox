{
  "name": "@tigawanna/expo-assets",
  "version": "0.1.0",
  "description": "Generate the complete Expo icon, adaptive icon and splash screen set from one SVG or PNG.",
  "keywords": [
    "adaptive-icon",
    "app-icon",
    "assets",
    "cli",
    "expo",
    "react-native",
    "splash-screen"
  ],
  "homepage": "https://github.com/tigawanna/assets-toolbox/tree/main/packages/expo-assets#readme",
  "bugs": {
    "url": "https://github.com/tigawanna/assets-toolbox/issues"
  },
  "license": "MIT",
  "author": "tigawanna <tigawanna@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tigawanna/assets-toolbox.git",
    "directory": "packages/expo-assets"
  },
  "bin": {
    "expo-assets": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "start": "node dist/cli.mjs",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:fix": "vp fmt --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check-exports": "attw --pack . --profile node16 --ignore-rules cjs-resolves-to-esm",
    "postbuild": "npm run check-exports",
    "prepublishOnly": "pnpm run build",
    "release": "changeset publish:expo-assets"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.9",
    "bumpp": "^12.3.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
