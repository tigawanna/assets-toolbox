{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@tigawanna/cabra-sound": ["../../../packages/cabra-sound/src/index.ts"],
      "@/server/fns": ["../../../packages/screenshot-studio/src/desktop/browser-fns.ts"],
      "@/*": ["../../../packages/screenshot-studio/src/*"],
      "@assets/screenshot-studio/*": ["../../../packages/screenshot-studio/src/*"],
      "@assets/expo-assets/*": ["../../../packages/expo-assets/src/*"],
      "@assets/social-inspect/*": ["../../../packages/social-inspect/app/src/*"],
      "@assets/svg-compose/*": ["../../../packages/svg-compose/src/*"],
      "@inspect/*": ["../../../packages/social-inspect/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
