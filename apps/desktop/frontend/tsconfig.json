{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/server/fns": ["./src/lib/modules/screenshot-studio/local/fns.ts"],
      "@tanstack/react-router": ["./src/lib/modules/screenshot-studio/local/router-shim.tsx"],
      "@/*": ["./src/lib/modules/screenshot-studio/*"]
    },
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["src/lib/wailsjs/**/*.js"]
}
