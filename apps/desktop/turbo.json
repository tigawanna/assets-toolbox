{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["@assets-toolbox/desktop#build"],
      "command": ["wails", "build", "-s", "-trimpath", "-ldflags", "-s -w"],
      "outputs": ["build/bin/**", "frontend/build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "command": ["node", "../../scripts/desktop.mjs", "dev"]
    },
    "test": {
      "dependsOn": [
        "@assets-toolbox/desktop#build",
        "@assets-toolbox/desktop#test",
        "@assets-toolbox/desktop#typecheck"
      ],
      "command": ["go", "test", "-tags=webkit2_41", "./..."]
    },
    "lint": {
      "dependsOn": ["@assets-toolbox/desktop#build", "@assets-toolbox/desktop#typecheck"],
      "command": ["go", "vet", "-tags=webkit2_41", "./..."]
    }
  }
}
